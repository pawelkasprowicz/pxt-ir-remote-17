{"entries":[{"timestamp":1794994173522,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":185,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":1,"length1":1069,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":34,"length1":71,"diffs":[[1,"    \"description\": \"\",\n"]]},{"start1":212,"length1":43,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":239,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"irremote.ts","value":"\nnamespace irremote {\n\n    export enum Button {\n        //% block=\"1\"\n        B1 = 0xA2,\n        //% block=\"2\"\n        B2 = 0x62,\n        //% block=\"3\"\n        B3 = 0xE2,\n        //% block=\"4\"\n        B4 = 0x22,\n        //% block=\"5\"\n        B5 = 0x02,\n        //% block=\"6\"\n        B6 = 0xC2,\n        //% block=\"7\"\n        B7 = 0xE0,\n        //% block=\"8\"\n        B8 = 0xA8,\n        //% block=\"9\"\n        B9 = 0x90,\n        //% block=\"*\"\n        Star = 0x68,\n        //% block=\"0\"\n        B0 = 0x98,\n        //% block=\"#\"\n        Hash = 0xB0,\n        //% block=\"▲\"\n        Up = 0x18,\n        //% block=\"▼\"\n        Down = 0x4A,\n        //% block=\"◀\"\n        Left = 0x10,\n        //% block=\"▶\"\n        Right = 0x5A,\n        //% block=\"OK\"\n        OK = 0x38\n    }\n\n    let lastButton = -1\n    let active = false\n    let irPin = DigitalPin.P15\n    let receivedBits = 0\n    let receivedData = 0\n    let lastPulseTime = 0\n\n    //% block=\"IR uruchom odbiornik na pinie %pin\"\n    //% pin.defl=DigitalPin.P15\n    //% group=\"Odbiornik\"\n    export function init(pin: DigitalPin): void {\n        irPin = pin\n        active = true\n        receivedBits = 0\n        receivedData = 0\n\n        pins.setPull(irPin, PinPullMode.PullNone)\n\n        pins.onPulsed(irPin, PulseValue.Low, function () {\n            let duration = pins.pulseDuration()\n\n            if (duration > 8000 && duration < 10000) {\n                receivedBits = 0\n                receivedData = 0\n            }\n        })\n\n        pins.onPulsed(irPin, PulseValue.High, function () {\n            let duration = pins.pulseDuration()\n\n            if (duration > 400 && duration < 800) {\n                receivedData = receivedData << 1\n                receivedBits += 1\n            } else if (duration > 1300 && duration < 1900) {\n                receivedData = (receivedData << 1) | 1\n                receivedBits += 1\n            }\n\n            if (receivedBits == 32) {\n                let command = (receivedData >> 8) & 0xFF\n                lastButton = command\n                lastPulseTime = input.runningTime()\n                receivedBits = 0\n                receivedData = 0\n            }\n        })\n    }\n\n    //% block=\"IR ostatni przycisk\"\n    //% group=\"Odczyt\"\n    export function last(): number {\n        return lastButton\n    }\n\n    //% block=\"IR czy przycisk %button\"\n    //% group=\"Odczyt\"\n    export function isPressed(button: Button): boolean {\n        return lastButton == button\n    }\n\n    //% block=\"IR wyczyść ostatni przycisk\"\n    //% group=\"Odczyt\"\n    export function clear(): void {\n        lastButton = -1\n    }\n}\n"}]},{"timestamp":1794994603597,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"257\" y=\"20\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":1,"length1":0,"diffs":[[1,"serial.redirectToUSB()\n\nirremote.init(DigitalPin.P15)\n\nserial.writeLine(\"=== TEST IR REMOTE 17 ===\")\nserial.writeLine(\"Odbiornik: P15\")\nserial.writeLine(\"Naciskaj przyciski pilota\")\n\nlet ostatni = -1\n\nbasic.forever(function () {\n    let kod = irremote.last()\n\n    if (kod != -1 && kod != ostatni) {\n        ostatni = kod\n\n        serial.writeLine(\"KOD DEC: \" + kod)\n\n        if (kod == irremote.Button.B1) {\n            serial.writeLine(\"PRZYCISK: 1\")\n        } else if (kod == irremote.Button.B2) {\n            serial.writeLine(\"PRZYCISK: 2\")\n        } else if (kod == irremote.Button.B3) {\n            serial.writeLine(\"PRZYCISK: 3\")\n        } else if (kod == irremote.Button.Up) {\n            serial.writeLine(\"PRZYCISK: GORA\")\n        } else if (kod == irremote.Button.Down) {\n            serial.writeLine(\"PRZYCISK: DOL\")\n        } else if (kod == irremote.Button.OK) {\n            serial.writeLine(\"PRZYCISK: OK\")\n        } else {\n            serial.writeLine(\"INNY PRZYCISK\")\n        }\n\n        serial.writeLine(\"----------------\")\n    }\n\n    basic.pause(20)\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":310,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]},{"type":"edited","filename":"irremote.ts","patch":[{"start1":1,"length1":132,"diffs":[[1,""]]},{"start1":763,"length1":89,"diffs":[[1,"    let lastButton = -1\n    let active = false\n"]]},{"start1":841,"length1":29,"diffs":[[1,""]]},{"start1":891,"length1":26,"diffs":[[1,"    let lastPulseTime = 0\n"]]},{"start1":918,"length1":1460,"diffs":[[1,""]]},{"start1":1027,"length1":19,"diffs":[[1,""]]},{"start1":1077,"length1":84,"diffs":[[1,""]]},{"start1":1097,"length1":0,"diffs":[[1,"        active = true\n        receivedBits = 0\n        receivedData = 0\n"]]},{"start1":1221,"length1":148,"diffs":[[1,"        pins.onPulsed(irPin, PulseValue.Low, function () {\n            let duration = pins.pulseDuration()\n"]]},{"start1":1329,"length1":394,"diffs":[[1,"            if (duration > 8000 && duration < 10000) {\n                receivedBits = 0\n                receivedData = 0\n"]]},{"start1":1464,"length1":10,"diffs":[[1,"        })\n"]]},{"start1":1476,"length1":149,"diffs":[[1,"        pins.onPulsed(irPin, PulseValue.High, function () {\n            let duration = pins.pulseDuration()\n"]]},{"start1":1585,"length1":992,"diffs":[[1,"            if (duration > 400 && duration < 800) {\n                receivedData = receivedData << 1\n                receivedBits += 1\n            } else if (duration > 1300 && duration < 1900) {\n                receivedData = (receivedData << 1) | 1\n                receivedBits += 1\n"]]},{"start1":1884,"length1":10,"diffs":[[1,""]]},{"start1":1885,"length1":954,"diffs":[[1,"            if (receivedBits == 32) {\n                let command = (receivedData >> 8) & 0xFF\n                lastButton = command\n                lastPulseTime = input.runningTime()\n                receivedBits = 0\n                receivedData = 0\n"]]},{"start1":2167,"length1":1555,"diffs":[[1,""]]},{"start1":2226,"length1":18,"diffs":[[1,""]]},{"start1":2296,"length1":37,"diffs":[[1,"    //% block=\"IR czy przycisk %button\"\n"]]},{"start1":2359,"length1":87,"diffs":[[1,"    export function isPressed(button: Button): boolean {\n        return lastButton == button\n"]]},{"start1":2526,"length1":18,"diffs":[[1,""]]}]}]},{"timestamp":1794995118132,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":372,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":310,"length1":75,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// tu są testy; nie będzie to kompilowane, gdy ten pakiet będzie używany jako rozszerzenie.\n"}]}],"snapshots":[{"timestamp":